{:paths ["src" "resources"]
 :deps {org.clojure/clojure         {:mvn/version "1.12.6"}
        org.clojure/spec.alpha      {:mvn/version "0.5.238"}
        ;; carried over from project.clj :dependencies
        com.bhauman/rebel-readline  {:mvn/version "0.1.4"}
        djblue/portal               {:mvn/version "0.45.0"}
        amazonica/amazonica         {:mvn/version "0.3.164"}
        com.cognitect.aws/api       {:mvn/version "0.8.686"}
        com.cognitect.aws/endpoints {:mvn/version "1.1.12.489"}
        com.cognitect.aws/s3        {:mvn/version "848.2.1413.0"}
        com.cognitect.aws/glue      {:mvn/version "848.2.1413.0"}
        com.cognitect.aws/sagemaker {:mvn/version "848.2.1413.0"}
        com.cognitect.aws/bedrock   {:mvn/version "869.2.1616.0"}
        com.cognitect.aws/lambda    {:mvn/version "848.2.1413.0"}
        ;; com.cognitect.aws/cloudwatch   {:mvn/version "848.2.1413.0"}
        ;; com.cognitect.aws/comprehend   {:mvn/version "848.2.1413.0"}
        ;; com.cognitect.aws/lex          {:mvn/version "848.2.1413.0"}
        com.cognitect.aws/kendra    {:mvn/version "848.2.1413.0"}
        ;; com.cognitect.aws/personalize  {:mvn/version "848.2.1413.0"}
        com.cognitect.aws/dynamodb  {:mvn/version "848.2.1413.0"}
        ;; com.cognitect.aws/opensearch   {:mvn/version "848.2.1413.0"}
        org.clojure/data.json       {:mvn/version "2.4.0"}
        clj-http/clj-http           {:mvn/version "3.12.3"}}

 :aliases
 {;; REPL: clj -M:dev  (dev/user.clj instruments all s/fdef'd fns)
  ;; was lein :dev profile (+ tools.namespace)
  :dev  {:extra-paths ["dev" "test"]
         :extra-deps {org.clojure/test.check      {:mvn/version "1.1.3"}
                      org.clojure/tools.namespace {:mvn/version "1.4.4"}}}

  ;; bb test  ->  clojure -M:test
  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; bb lint  ->  clojure -M:lint --lint src test dev
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
         :main-opts ["-m" "clj-kondo.main"]}

  ;; bb fmt / bb fmt:fix  ->  clojure -M:fmt check|fix src test dev
  ;; (replaces the lein-cljfmt plugin)
  :fmt  {:replace-deps {dev.weavejester/cljfmt {:mvn/version "0.16.5"}}
         :main-opts ["-m" "cljfmt.main"]}

  ;; --- ported from project.clj ---

  ;; lein run (:main aif-c01.core)  ->  clojure -M:run  /  bb run
  :run  {:main-opts ["-m" "aif-c01.core"]}

  ;; lein rebel  ->  clojure -M:dev:rebel
  :rebel {:main-opts ["-m" "user"]}

  ;; lein portal  ->  clojure -M:portal
  :portal {:main-opts ["-m" "portal.main"]}

  ;; lein :lcl profile (LocalStack)  ->  clojure -M:dev:lcl
  ;; lein :env {:endpoint-override ...} cannot be set from deps.edn:
  ;;   export endpoint-override=http://localhost:4566
  :lcl  {:extra-deps {org.testcontainers/localstack {:mvn/version "1.17.3"}}
         :jvm-opts ["-Daws.region=us-east-1"
                    "-Daws.accessKeyId=test"
                    "-Daws.secretKey=test"]}

  ;; lein :dev-aws profile  ->  clojure -M:dev:dev-aws  (export AWS_PROFILE=dev)
  :dev-aws {:jvm-opts ["-Daws.region=us-east-1"]}

  ;; lein-kibit plugin  ->  clojure -M:kibit  (kibit 0.1.8 has no -main)
  :kibit {:extra-paths ["test"]
          :extra-deps {jonase/kibit {:mvn/version "0.1.8"}}
          :main-opts ["-e" "(require 'kibit.driver) (kibit.driver/external-run [\"src\" \"test\"] nil)"]}

  ;; eastwood plugin  ->  clojure -M:eastwood
  :eastwood {:extra-paths ["test"]
             :extra-deps {jonase/eastwood {:mvn/version "1.4.0"}}
             :main-opts ["-m" "eastwood.lint" "{:source-paths [\"src\"] :test-paths [\"test\"]}"]}}}
